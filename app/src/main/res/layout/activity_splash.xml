<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_background"
    android:padding="24dp">

    <!-- 顶部信息区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/terminal_green"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.2.0"
            android:textColor="@color/terminal_green"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal Overtime Record System"
            android:textColor="@color/terminal_green"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_green"
        android:layout_marginBottom="16dp" />

    <!-- POST 状态显示区 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPostLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/terminal_green"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="" />

            <TextView
                android:id="@+id/tvCursor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="_"
                android:textColor="@color/terminal_green"
                android:textSize="14sp"
                android:fontFamily="monospace" />

        </LinearLayout>

    </ScrollView>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/terminal_green"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- 进度条区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/terminal_progress"
            android:background="@drawable/terminal_progress_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvProgressPercent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0%"
                android:textColor="@color/terminal_green"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initializing..."
                android:textColor="@color/terminal_green"
                android:textSize="12sp"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

    <!-- 底部提示 -->
    <TextView
        android:id="@+id/tvReadyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="System ready. Loading..."
        android:textColor="@color/terminal_green"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

</LinearLayout>