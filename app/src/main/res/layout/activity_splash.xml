<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a1a">

    <!-- 背景网格效果 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scifi_grid" />

    <!-- 主要内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- 顶部Logo区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <!-- 发光标题 -->
            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OVERTIME RECORD"
                android:textColor="#00ffff"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textAllCaps="true"
                android:shadowColor="#00ffff"
                android:shadowRadius="10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.3.0"
                android:textColor="#00ff88"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUANTUM TIME TRACKING SYSTEM"
                android:textColor="#00aa66"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.2" />

        </LinearLayout>

        <!-- 全息投影效果的分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/holographic_line"
            android:layout_marginBottom="24dp" />

        <!-- POST 状态显示区 -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#111122"
            android:alpha="0.8"
            android:padding="12dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPostLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#00ff88"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="6dp"
                    android:text="" />

                <TextView
                    android:id="@+id/tvCursor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="_"
                    android:textColor="#00ff88"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

        </ScrollView>

        <!-- 科幻风格进度条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 进度条容器 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="#0a0a1a"
                android:padding="2dp"
                android:layout_marginBottom="12dp">

                <!-- 背景 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#1a1a2e" />

                <!-- 流动进度条 -->
                <View
                    android:id="@+id/progressBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/scifi_progress" />

                <!-- 发光效果覆盖层 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/glow_overlay" />

            </FrameLayout>

            <!-- 状态信息 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00ffff"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:layout_alignParentLeft="true" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INITIALIZING..."
                    android:textColor="#00ff88"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_alignParentRight="true" />

            </RelativeLayout>

        </LinearLayout>

        <!-- 底部提示 -->
        <TextView
            android:id="@+id/tvReadyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SYSTEM READY. ENTERING MAIN INTERFACE..."
            android:textColor="#00ffff"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            android:textAllCaps="true" />

    </LinearLayout>

    <!-- 扫描线效果 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scanner_lines"
        android:alpha="0.1" />

</FrameLayout>